<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Description>High-performance YAML front matter parser, cross-file schema inference, and parallel directory scanner for Markdown files. Built on VYaml.</Description>
    <PackageTags>fsharp;yaml;frontmatter;parser;schema-inference</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="FrontMatterTextReader.fs" />
    <Compile Include="SchemaInference.fs" />
    <Compile Include="Schemas.fs" />
    <Compile Include="FrontMatterReader.fs" />
    <Compile Include="Scanner.fs" />
    <Compile Include="Skill.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VYaml" Version="1.3.0" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

</Project>
