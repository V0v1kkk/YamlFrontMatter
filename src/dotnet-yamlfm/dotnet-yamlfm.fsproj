<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yamlfm</ToolCommandName>
    <Description>CLI tool for scanning Markdown YAML front matter and printing inferred schemas.</Description>
    <PackageTags>fsharp;yaml;frontmatter;cli;tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YamlFrontMatter\YamlFrontMatter.fsproj" />
  </ItemGroup>

</Project>
