<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Place the design-time component under typeproviders/fsharp41/<tfm>/
         (the modern F# compiler/FSI probing path). The SDK default of
         tools/fsharp41/<tfm>/ is legacy and is NOT picked up by .NET 6+ FSI. -->
    <FSharpToolsDirectory>typeproviders</FSharpToolsDirectory>
    <Description>F# Type Provider that gives compile-time typed access to YAML front matter in Markdown files. Scans a directory at design time, infers a cross-file schema, and generates strongly-typed properties.</Description>
    <PackageTags>fsharp;typeprovider;yaml;frontmatter</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RuntimeHelpers.fs" />
    <Compile Include="AssemblyInfo.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YamlFrontMatter\YamlFrontMatter.fsproj" />
    <ProjectReference Include="..\YamlFrontMatter.TypeProvider.DesignTime\YamlFrontMatter.TypeProvider.DesignTime.fsproj">
      <IsFSharpDesignTimeProvider>true</IsFSharpDesignTimeProvider>
      <PrivateAssets>all</PrivateAssets>
    </ProjectReference>
  </ItemGroup>

  <!--
    Explicitly bundle the design-time component (TPDTC) and all its runtime
    deps into typeproviders/fsharp41/<tfm>/. This deliberately bypasses the
    SDK's CollectFSharpDesignTimeTools auto-collector, which has produced
    stub-only packages on GitHub Actions runners (0.9.1–0.9.5 all shipped
    27 KB nupkgs missing the design-time DLL).
    Wired as an AfterTargets="Build" target so the DesignTime project is
    guaranteed to be built before its bin/ is glob-included.
  -->
  <Target Name="CollectDesignTimeFiles" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\YamlFrontMatter.TypeProvider.DesignTime\YamlFrontMatter.TypeProvider.DesignTime.fsproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <ItemGroup>
      <!-- Top-level DLLs only — skip locale satellite folders (cs/, de/, ...). -->
      <_DesignTimeOutput Include="..\YamlFrontMatter.TypeProvider.DesignTime\bin\$(Configuration)\$(TargetFramework)\*.dll"
                         Exclude="..\YamlFrontMatter.TypeProvider.DesignTime\bin\$(Configuration)\$(TargetFramework)\FSharp.Core.dll" />
      <None Include="@(_DesignTimeOutput)"
            Pack="true"
            PackagePath="typeproviders/fsharp41/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

</Project>
