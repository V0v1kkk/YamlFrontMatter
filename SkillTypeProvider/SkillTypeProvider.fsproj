<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Copy all transitive deps alongside the TP DLL so the compiler host can load them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Compile ProvidedTypes.fs source directly into the TP assembly (no external DLL dep) -->
  <ItemGroup>
    <Compile Include="$(NuGetPackageRoot)/fsharp.typeproviders.sdk/8.10.0/src/ProvidedTypes.fsi" />
    <Compile Include="$(NuGetPackageRoot)/fsharp.typeproviders.sdk/8.10.0/src/ProvidedTypes.fs" />
    <Compile Include="SkillCollectionProvider.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.TypeProviders.SDK" Version="8.10.0">
      <!-- We use the source files directly, so exclude the DLL -->
      <ExcludeAssets>compile;runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.0" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkillFrontMatter.Core\SkillFrontMatter.Core.fsproj" />
  </ItemGroup>

</Project>
